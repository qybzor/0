# Secretos SOLO para Edge Functions. No colocar claves privadas en el navegador.
# La URL y publishable key públicas del frontend ya están configuradas en billing-client.js.
MERCADOPAGO_ACCESS_TOKEN=APP_USR_REPLACE_WITH_PRIVATE_ACCESS_TOKEN
MERCADOPAGO_WEBHOOK_SECRET=REPLACE_WITH_WEBHOOK_SIGNING_SECRET
APP_BASE_URL=https://your-qybzor-domain.example
OPENAI_API_KEY=REPLACE_WITH_SERVER_SIDE_KEY
WHATSAPP_TOKEN_ENCRYPTION_KEY=BASE64_OF_32_RANDOM_BYTES
META_WEBHOOK_VERIFY_TOKEN=LONG_RANDOM_VERIFICATION_PHRASE
META_APP_ID=REPLACE_WITH_META_APP_ID
META_APP_SECRET=REPLACE_WITH_META_APP_SECRET
META_GRAPH_VERSION=v27.0
OPENAI_MODEL=gpt-4.1-mini
# Supabase provides SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY to Edge Functions.
